pipeline{
    agent any

    parameters{
        choice(name: 'BRANCH',
        choices: ['main','production']
        description: 'choose the branch')
    }

    stages{
        stage('checkout'){
            steps{
                git branch: params.BRANCH, 
                credentialsId: 'my_github_account', 
                url: 'https://github.com/ManjunathVenkatesh-Mandya/python_practice.git'
            }
        }

        stage('BUILD_IN_MAIN'){
            when {
                expression {
                    return params.BRANCH == 'main'
                }
            }
            steps{
                sh 
                '''
                echo "SHELL ---> Branch: $BRANCH"
                '''
                }
            }
            
        stage('BUILD_IN_PRODUCTION'){
            when {
                expression{
                    return params.BRANCH == 'production'
                }
            }
            steps{
                sh '''
                echo "SHELL ---> Branch: $BRANCH"
                '''
            }
        }
    }
}