pipeline{
    agent any

    parameters{
        choice(name: 'BRANCH', 
        choices: ['main', 'production'],
        description: 'enter the branch name')
    }

    stages{
        stage('checkout'){
            steps{
                git branch: params.BRANCH, 
                credentialsId: 'my_github_account', 
                url: 'https://github.com/ManjunathVenkatesh-Mandya/python_practice.git'
            }
        }

        stage('BRANCH_MAIN'){
            when {
                expression {
                    return params.BRANCH == 'main'
                }
            }

            steps{
                sh '''
                echo "branch is: $BRANCH"
                '''
            }
        }

        stage('BRANCH_PRODUCTION'){
            when {
                expression{
                    return params.BRANCH == 'production'
                }
            }

            steps{
                sh '''
                echo "branch is : $BRANCH"
                '''
            }
        }


    }
}