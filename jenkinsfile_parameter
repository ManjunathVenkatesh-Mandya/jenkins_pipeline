pipeline{
    agent any

    parameters{

        string(name:MY_NAME,
        defaultValue:xyz,
        description:'enter your good name')

        string(name:MY_AGE,
        defaultValue:18,
        description:'enter your age')

        choice(name:'CITY',
        choices:['Mandya','Mysuru','Bengaluru'],
        description:'choose your city')

    }

    stages{
        stage('build'){
            steps{
                sh '''
                echo "my name is $MY_NAME, my age is ${MY_AGE}years and my city is $CITY"
                '''
            }
        }
    }
}